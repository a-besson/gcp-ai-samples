# KICS configuration — scanned IaC: all samples.
# Accepted findings are ignored INLINE next to the resource (`# kics-scan ignore-line` /
# `# kics-scan disable=<query-id>`) with the reason as a comment — never globally here.
fail-on:
  - high
  - critical
# Virtualenvs, provider binaries and build output are not repository code
exclude-paths:
  - /path/.git
  - /path/samples/geap-agent-simple/.venv
  - /path/samples/base/.terraform
  - /path/samples/geap-agent-simple/.terraform
  - /path/samples/geap-agent-simple/build
  - /path/samples/geap-agent-secured/.venv
  - /path/samples/geap-agent-secured/.terraform
  - /path/samples/geap-agent-secured/build
