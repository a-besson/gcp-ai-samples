# Copy to .env (gitignored) and fill in. Placeholders only — never commit real values.
GCP_PROJECT_ID=my-gcp-project-id
GCP_REGION=europe-west1
# Remote state bucket (created by `task bootstrap`)
TF_STATE_BUCKET=my-gcp-project-id-tfstate
# Billing account for the budget alerts (format XXXXXX-XXXXXX-XXXXXX). Leave empty to use the account linked to the project when readable, else no budget.
TF_VAR_billing_account=XXXXXX-XXXXXX-XXXXXX
